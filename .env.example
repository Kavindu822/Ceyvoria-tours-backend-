# ==============================================================================
# CEYVORIA TOURS — BACKEND (.NET) ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# In production / cloud hosting (Render, Railway, Fly.io, Azure, Docker, etc.),
# set these as environment variables in your hosting dashboard.
# In local development, copy this to `.env` or use `dotnet user-secrets`.

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT & RUNTIME
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
# Server port (Render / Railway / Cloud providers set this automatically)
PORT=5050

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Standard ADO.NET connection string format for PostgreSQL
# Example for Docker/Local: Host=localhost;Port=5433;Database=ceyvoria;Username=ceyvoria;Password=YOUR_PASSWORD
# Example for Managed Cloud DB (Neon/Supabase/Railway): Host=ep-xyz.us-east-2.aws.neon.tech;Port=5432;Database=ceyvoria;Username=ceyvoria_owner;Password=XYZ;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=ceyvoria;Username=postgres;Password=REPLACE_WITH_YOUR_DB_PASSWORD

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Cryptographically secure random secret key (MUST be at least 48 characters / bytes long for HMAC-SHA256)
Jwt__Secret=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS_FOR_JWT_SECURITY_2026
Jwt__Issuer=CeyvoriaTours
Jwt__Audience=CeyvoriaToursWebsite

# ------------------------------------------------------------------------------
# 4. CORS ORIGINS (Frontend Domains Allowed to Call this API)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (e.g. production domain and local dev)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://ceyvoria.com,https://ceyvoria-tours.vercel.app

# ------------------------------------------------------------------------------
# 5. INITIAL ADMIN BOOTSTRAP (Optional)
# ------------------------------------------------------------------------------
# Used once to create the first administrator account if no admin exists.
# Passwords must be at least 12 characters. Remove or unset after bootstrap.
ADMIN_BOOTSTRAP_EMAIL=admin@ceyvoria.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeImmediately123!

# ------------------------------------------------------------------------------
# 6. PAYMENTS GATEWAY STATUS
# ------------------------------------------------------------------------------
# Keep false until live merchant approval, provider verification, and webhooks are ready.
PAYMENTS_ENABLED=false
